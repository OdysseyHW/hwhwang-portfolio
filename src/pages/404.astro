---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 페이지를 찾을 수 없습니다." noindex>
  <section class="not-found container" aria-labelledby="nf-title">
    <p class="eyebrow">404</p>
    <h1 id="nf-title" class="not-found__title">페이지를 찾을 수 없습니다</h1>
    <p class="muted not-found__text">주소가 바뀌었거나 삭제된 페이지입니다. 아래 버튼으로 작업물 목록으로 이동할 수 있습니다.</p>
    <div class="not-found__actions">
      <a class="button button--primary" href={`${withBase()}#works`}>작업물 목록으로</a>
      <a class="button" href={withBase()}>메인으로</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-section);
  }

  .not-found__title {
    font-size: var(--text-2xl);
  }

  .not-found__text {
    max-width: var(--reading-max);
    margin-top: var(--space-4);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
