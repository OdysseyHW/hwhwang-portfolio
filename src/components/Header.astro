---
/**
 * 상단 내비게이션 (REQ-006)
 * - 왼쪽 이름, 오른쪽 길이가 다른 가는 3선 메뉴 버튼 — 모든 화면에서 같은 구성.
 * - 버튼을 누르면 전체 화면 메뉴(모달 <dialog>)가 열린다: 배경 감광·블러, 큰 Works/About/Contact, 보조 칼럼.
 * - 모달이라 배경은 inert, Escape·닫기 버튼 지원, 초점은 메뉴 안에서 순환하고 닫으면 버튼·스크롤 위치로 돌아온다.
 * - 메뉴 항목으로 이동하면 메뉴를 닫고 목적지 제목에 초점을 준다 (상세 페이지에서는 메인의 해당 영역으로 이동).
 */
import { site } from '../data/site';
import { hero } from '../data/hero';
import { withBase } from '../lib/url';

interface Props {
  /** 히어로 위에 겹쳐 투명하게 시작하고, 스크롤하면 불투명해진다 (메인 전용) */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const home = withBase();
const links = [
  { label: 'Works', href: `${home}#works` },
  { label: 'About', href: `${home}#about` },
  { label: 'Contact', href: `${home}#contact` },
];
// 보조 칼럼의 연락처는 실제 값일 때만 (임시 연락처를 실제 주소처럼 노출하지 않음)
const showContact = !site.contactIsSample && (Boolean(site.email) || site.socialLinks.length > 0);
---

<header class:list={['site-header', overlay && 'site-header--overlay']} data-site-header data-overlay={overlay ? '' : undefined}>
  <div class="container site-header__inner">
    <a class="logo" href={home}>{site.name}</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="메뉴 열기" data-menu-toggle>
      <span class="menu-btn__lines" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</header>

<dialog id="site-menu" class="site-menu" aria-label="사이트 메뉴" data-menu>
  <div class="site-menu__scrim" aria-hidden="true"></div>
  <div class="site-menu__panel">
    <div class="container site-menu__bar">
      <a class="logo" href={home} data-menu-link>{site.name}</a>
      <button class="menu-btn is-close" type="button" aria-label="메뉴 닫기" data-menu-close>
        <span class="menu-btn__lines" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>

    <div class="container site-menu__body">
      <nav class="site-menu__nav" aria-label="주요 메뉴">
        <ol class="site-menu__list">
          {
            links.map((l, i) => (
              <li style={`--i: ${i}`}>
                <a class="site-menu__link" href={l.href} data-menu-link>
                  <span class="site-menu__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="site-menu__label">{l.label}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <aside class="site-menu__aside" aria-label="소개">
        <p class="site-menu__role">{site.jobTitle}</p>
        <p class="site-menu__desc">{hero.description}</p>
        {
          showContact && (
            <ul class="site-menu__contact">
              {site.email && (
                <li>
                  <a href={`mailto:${site.email}`}>{site.email}</a>
                </li>
              )}
              {site.socialLinks.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener noreferrer">
                    {s.label}
                    <span class="visually-hidden"> (새 탭)</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </aside>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-header-bg);
    border-bottom: var(--border-width) solid var(--color-border);
    transition: background-color var(--duration) var(--ease), border-color var(--duration) var(--ease);
  }

  /* 메인 히어로 위: 투명한 검정 그라디언트. 스크롤하면 불투명 검정 */
  .site-header--overlay:not(.is-solid) {
    background: linear-gradient(rgb(0 0 0 / 0.6), rgb(0 0 0 / 0)) border-box; /* 테두리 영역까지 같은 그라디언트 (반복 줄 방지) */
    border-bottom-color: transparent;
  }

  .site-header__inner,
  .site-menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    min-width: 0;
    font-weight: var(--weight-heading);
    letter-spacing: 0.02em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  /* ---------- 3선 메뉴 버튼 ---------- */
  .menu-btn {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    margin-right: -10px; /* 선의 오른쪽 끝을 콘텐츠 정렬선에 맞춤 */
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .menu-btn__lines {
    position: relative;
    display: block;
    width: 26px;
    height: 14px;
  }

  /* 길이가 다른 가는 선 3개 (오른쪽 정렬) */
  .menu-btn__lines span {
    position: absolute;
    right: 0;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: width var(--menu-line-dur) var(--ease), transform var(--menu-line-dur) var(--ease), opacity var(--menu-line-dur) var(--ease), top var(--menu-line-dur) var(--ease);
  }

  .menu-btn__lines span:nth-child(1) {
    top: 0;
    width: 26px;
  }

  .menu-btn__lines span:nth-child(2) {
    top: 6.25px;
    width: 18px;
  }

  .menu-btn__lines span:nth-child(3) {
    top: 12.5px;
    width: 10px;
  }

  /* hover·focus: 길이가 정돈됨 */
  .menu-btn:hover .menu-btn__lines span,
  .menu-btn:focus-visible .menu-btn__lines span {
    width: 26px;
  }

  /* 닫기(X) 상태 */
  .menu-btn.is-close .menu-btn__lines span,
  .menu-btn[aria-expanded='true'] .menu-btn__lines span {
    top: 6.25px;
    width: 26px;
  }

  .menu-btn.is-close .menu-btn__lines span:nth-child(1),
  .menu-btn[aria-expanded='true'] .menu-btn__lines span:nth-child(1) {
    transform: rotate(45deg);
  }

  .menu-btn.is-close .menu-btn__lines span:nth-child(2),
  .menu-btn[aria-expanded='true'] .menu-btn__lines span:nth-child(2) {
    opacity: 0;
  }

  .menu-btn.is-close .menu-btn__lines span:nth-child(3),
  .menu-btn[aria-expanded='true'] .menu-btn__lines span:nth-child(3) {
    transform: rotate(-45deg);
  }

  /* ---------- 전체 화면 메뉴 ---------- */
  .site-menu {
    --menu-in: 320ms;
    --menu-out: 200ms;
    position: fixed;
    inset: 0;
    /* 내용은 페이지와 같은 폭(스크롤바 여백 제외)이라 열어도 로고·버튼 위치가 그대로다 */
    width: 100%;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    overflow: visible;
  }

  .site-menu::backdrop {
    background: transparent;
  }

  /* 배경 감광은 스크롤바 여백까지 덮는다 */
  .site-menu__scrim {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100%;
    background: rgb(0 0 0 / 0);
    transition: background-color 260ms var(--ease), backdrop-filter 260ms var(--ease), -webkit-backdrop-filter 260ms var(--ease);
  }

  .site-menu.is-open .site-menu__scrim {
    background: rgb(5 5 5 / 0.72);
    -webkit-backdrop-filter: blur(10px) grayscale(1);
    backdrop-filter: blur(10px) grayscale(1);
  }

  /* 블러를 지원하지 않으면 불투명에 가까운 검정으로도 충분히 읽히게 */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-menu.is-open .site-menu__scrim {
      background: rgb(5 5 5 / 0.94);
    }
  }

  .site-menu.is-closing .site-menu__scrim {
    transition-duration: var(--menu-out);
  }

  /* 패널: 메뉴가 화면보다 길면 패널 안에서만 스크롤, 상단 바(닫기)는 고정 */
  .site-menu__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }

  .site-menu__bar {
    position: sticky;
    top: 0;
    z-index: 1;
    flex-shrink: 0;
  }

  .site-menu__body {
    display: grid;
    flex: 1;
    align-content: center;
    gap: var(--space-7);
    padding-block: var(--space-6) var(--space-7);
  }

  @media (min-width: 56.25em) {
    .site-menu__body {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .site-menu__list {
    display: grid;
    gap: clamp(0.25rem, 1vh, 0.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 항목: 아래에서 올라오며 나타남 (60~80ms 간격) */
  .site-menu__list li,
  .site-menu__aside {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity var(--menu-in) var(--ease), transform var(--menu-in) var(--ease);
  }

  .site-menu__list li {
    transition-delay: calc(120ms + var(--i) * 70ms);
  }

  .site-menu__aside {
    transition-delay: 300ms;
  }

  .site-menu.is-open .site-menu__list li,
  .site-menu.is-open .site-menu__aside {
    opacity: 1;
    transform: none;
  }

  /* 닫기는 짧게, 간격 없이 */
  .site-menu.is-closing .site-menu__list li,
  .site-menu.is-closing .site-menu__aside {
    transition-duration: var(--menu-out);
    transition-delay: 0ms;
  }

  .site-menu__link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-4);
    min-height: var(--tap-min);
    max-width: 100%;
    color: var(--color-text);
    font-size: clamp(2.5rem, 1.6rem + 4.5vw, 6rem);
    font-weight: var(--weight-heading);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .site-menu__label {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
    transition: text-decoration-color var(--duration) var(--ease);
  }

  .site-menu__link:hover .site-menu__label,
  .site-menu__link:focus-visible .site-menu__label {
    text-decoration-color: currentColor;
  }

  .site-menu__num {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
  }

  .site-menu__aside {
    display: grid;
    gap: var(--space-3);
    max-width: 32rem;
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  .site-menu__role {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .site-menu__desc {
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .site-menu__contact {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .site-menu__contact a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    overflow-wrap: anywhere;
  }

  :root {
    --menu-line-dur: 180ms;
  }

  /* 모션 줄이기: 항목 이동 없이 짧은 페이드만 (메뉴 기능은 그대로) */
  @media (prefers-reduced-motion: reduce) {
    :root {
      --menu-line-dur: 0ms;
    }

    .site-menu {
      --menu-in: 120ms;
      --menu-out: 0ms;
    }

    .site-menu__list li,
    .site-menu__aside {
      transform: none;
      transition-delay: 0ms !important;
    }

    .site-menu__scrim {
      transition-duration: 120ms;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');

  // 오버레이 헤더: 조금이라도 스크롤하면 불투명 배경
  if (header?.hasAttribute('data-overlay')) {
    let ticking = false;
    const update = () => header.classList.toggle('is-solid', window.scrollY > 16);
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
    update();
  }

  if (toggle && dialog) {
    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-menu-close]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const OPEN_MS = 600;
    const CLOSE_MS = 220;

    type State = 'closed' | 'opening' | 'open' | 'closing';
    let state: State = 'closed';
    let timer = 0;
    let savedScrollY = 0;

    const announce = (open: boolean) => document.dispatchEvent(new CustomEvent('site-menu:toggle', { detail: { open } }));

    const open = () => {
      if (state === 'open' || state === 'opening') return;
      window.clearTimeout(timer);
      if (!dialog.open) {
        savedScrollY = window.scrollY;
        document.documentElement.style.overflow = 'hidden';
        dialog.showModal();
        announce(true);
      }
      dialog.classList.remove('is-closing');
      void dialog.offsetWidth; // 시작 상태를 확정한 뒤 열림 전환
      dialog.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      state = 'opening';
      dialog.querySelector<HTMLElement>('.site-menu__link')?.focus();
      timer = window.setTimeout(() => (state = 'open'), reduce.matches ? 0 : OPEN_MS);
    };

    /** restoreFocus: 버튼으로 초점 복원 / restoreScroll: 연 시점의 스크롤 위치로 / immediate: 애니메이션 없이 */
    const close = ({ restoreFocus = true, restoreScroll = true, immediate = false } = {}) => {
      if (state === 'closed') return;
      window.clearTimeout(timer);
      dialog.classList.remove('is-open');
      dialog.classList.add('is-closing');
      toggle.setAttribute('aria-expanded', 'false');
      state = 'closing';
      const finish = () => {
        dialog.classList.remove('is-closing');
        if (dialog.open) dialog.close();
        document.documentElement.style.overflow = '';
        if (restoreScroll) window.scrollTo({ top: savedScrollY, behavior: 'instant' as ScrollBehavior });
        state = 'closed';
        if (restoreFocus) toggle.focus({ preventScroll: true });
        announce(false);
      };
      if (immediate || reduce.matches) finish();
      else timer = window.setTimeout(finish, CLOSE_MS);
    };

    toggle.addEventListener('click', open);
    closeBtn.addEventListener('click', () => close());

    // Escape: 브라우저 기본 즉시 닫기 대신 같은 닫기 동작으로 (잠금·초점 정리)
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });

    // 메뉴 안에서 Tab 순환
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const items = [...dialog.querySelectorAll<HTMLElement>('a[href], button')];
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // 메뉴 항목: 같은 페이지 앵커면 닫고 이동한 뒤 목적지 제목에 초점, 다른 페이지면 닫고 이동
    dialog.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-menu-link]');
      if (!a) return;
      const url = new URL(a.href);
      const samePage = url.pathname === location.pathname;
      if (samePage && url.hash) {
        e.preventDefault();
        close({ restoreFocus: false, restoreScroll: true, immediate: true });
        const target = document.querySelector<HTMLElement>(url.hash);
        if (!target) return;
        history.pushState(null, '', url.hash);
        target.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' });
        const heading = target.querySelector<HTMLElement>('h2, h1') ?? target;
        if (!heading.hasAttribute('tabindex')) heading.setAttribute('tabindex', '-1');
        heading.focus({ preventScroll: true });
      } else {
        close({ restoreFocus: false, restoreScroll: false, immediate: true });
      }
    });

    // 뒤로가기 등으로 페이지가 캐시에서 복원될 때 메뉴가 열린 채 남지 않게
    window.addEventListener('pageshow', () => {
      if (state !== 'closed') close({ restoreFocus: false, immediate: true });
    });
  }
</script>
