---
/**
 * 메인 히어로: 배경 영상 + 대형 제목 + 짧은 소개 + 작업물 보기.
 * - 포스터(이미지)와 텍스트를 먼저 보여 주고, 영상은 JS가 화면 크기에 맞는 파일 하나만 불러온다.
 * - 모션 줄이기·데이터 절약·사용자가 멈춘 상태에서는 영상을 요청하지 않는다. 재생 버튼으로 직접 재생은 가능.
 * - 화면 밖으로 나가거나 탭이 숨겨지면 멈추고, 돌아오면 사용자가 멈추지 않은 경우에만 다시 재생한다.
 * - 재생이 막히거나 파일을 불러오지 못하면 포스터를 그대로 둔다 (페이지 동작은 막지 않음).
 */
import { hero } from '../data/hero';
import { withBase } from '../lib/url';

const toSources = (v?: string | string[]) =>
  (v ? (Array.isArray(v) ? v : [v]) : []).map((s) => {
    const url = /^https?:\/\//.test(s) ? s : withBase(s);
    return { url, type: url.endsWith('.webm') ? 'video/webm' : 'video/mp4' };
  });

const desktopSources = toSources(hero.videoDesktop);
const mobileSources = toSources(hero.videoMobile);
const hasVideo = desktopSources.length > 0 || mobileSources.length > 0;
const isAnchor = hero.ctaTarget.startsWith('#');
const ctaHref = isAnchor ? hero.ctaTarget : withBase(hero.ctaTarget);
const style = `--hero-focal: ${hero.focalPoint}; --hero-focal-mobile: ${hero.focalPointMobile ?? hero.focalPoint};`;
---

<section class="hero" aria-labelledby="hero-title" data-hero style={style}>
  <div class:list={['hero__media', hero.monochrome && 'hero__media--mono']} aria-hidden="true">
    <picture>
      {hero.posterMobile && <source media="(max-width: 39.99em)" srcset={hero.posterMobile.src} />}
      <img class="hero__poster" src={hero.posterDesktop.src} alt="" width={hero.posterDesktop.width} height={hero.posterDesktop.height} fetchpriority="high" decoding="async" />
    </picture>
    {
      hasVideo && (
        <video
          class="hero__video"
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          tabindex="-1"
          data-hero-video
          data-src-desktop={JSON.stringify(desktopSources.length ? desktopSources : mobileSources)}
          data-src-mobile={JSON.stringify(mobileSources.length ? mobileSources : desktopSources)}
        />
      )
    }
    <div class="hero__shade"></div>
  </div>

  <div class="container hero__content">
    <h1 id="hero-title" class="hero__title">
      {
        hero.titleLines.map((line, i) => (
          <>
            <span class="hero__line">{line}</span>
            {i < hero.titleLines.length - 1 ? ' ' : ''}
          </>
        ))
      }
    </h1>
    <p class="hero__desc">{hero.description}</p>
    <a class="button button--primary hero__cta" href={ctaHref}>
      {hero.ctaLabel}
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="container hero__bottom">
    <a class="hero__scroll" href={ctaHref}>
      <span class="hero__scroll-line" aria-hidden="true"></span>
      Scroll<span class="visually-hidden"> — 작업물 목록으로 이동</span>
    </a>
    {
      hasVideo && (
        <div class="hero__controls">
          {hero.sampleLabel && <span class="hero__sample">{hero.sampleLabel}</span>}
          <button type="button" class="hero__toggle" data-hero-toggle aria-label="배경 영상 재생">
            <svg class="hero__icon hero__icon--play" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
              <path d="M5 3.2v11.6L14.6 9 5 3.2Z" fill="currentColor" />
            </svg>
            <svg class="hero__icon hero__icon--pause" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
              <path d="M4.5 3h3v12h-3zM10.5 3h3v12h-3z" fill="currentColor" />
            </svg>
          </button>
          <span class="visually-hidden" role="status" data-hero-status />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh; /* 콘텐츠가 더 길면 자연스럽게 늘어난다 (고정 높이 아님) */
    margin-top: calc(var(--header-h) * -1 - var(--border-width));
    padding-top: var(--header-h);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: #000;
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-focal);
  }

  @media (max-width: 39.99em) {
    .hero__poster,
    .hero__video {
      object-position: var(--hero-focal-mobile);
    }
  }

  /* 영상은 실제로 재생되기 시작하면 포스터 위로 나타난다 */
  .hero__video {
    opacity: 0;
    transition: opacity 500ms var(--ease);
  }

  .hero.is-video-visible .hero__video {
    opacity: 1;
  }

  /* 히어로에서만 흑백 처리 — 프로젝트 상세의 원본 색은 그대로 */
  .hero__media--mono .hero__poster,
  .hero__media--mono .hero__video {
    filter: grayscale(1) contrast(1.05);
  }

  /* 밝은 장면에서도 흰 제목을 읽을 수 있도록 왼쪽·아래를 더 어둡게 */
  /*
   * 밝은 장면에서도 흰 글자를 읽을 수 있도록 검정 오버레이를 깐다.
   * 완전히 흰 프레임을 가정해도 글자가 놓이는 영역은 검정 60% 이상 → 흰 글자 대비 약 5.7:1 이상.
   * 좁은 화면은 글이 가로 전체를 쓰므로 균일하게, 넓은 화면은 제목이 끝나는 약 60% 지점까지 60% 이상 유지.
   */
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, var(--color-bg) 0%, rgb(10 10 10 / 0) 40%),
      rgb(0 0 0 / 0.62);
  }

  @media (min-width: 64em) {
    .hero__shade {
      background:
        linear-gradient(0deg, var(--color-bg) 0%, rgb(10 10 10 / 0) 40%),
        linear-gradient(90deg, rgb(0 0 0 / 0.82) 0%, rgb(0 0 0 / 0.62) 60%, rgb(0 0 0 / 0.4) 100%);
    }
  }

  .hero__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-block: clamp(2.5rem, 8vh, 6rem) var(--space-6);
    container-type: inline-size;
  }

  /*
   * 대형 제목: Zalando Sans Expanded 800.
   * 가장 긴 행(DESIGNED)이 약 6.5em이므로 14.5cqi로 상한을 두어 어떤 너비·글자 확대에서도 화면을 넘지 않게 한다.
   */
  .hero__title {
    max-width: 100%;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: min(clamp(2.5rem, 11vw, 4.5rem), 14.5cqi);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: wrap;
  }

  @media (min-width: 40em) {
    .hero__title {
      font-size: min(clamp(4rem, 8.5vw, 10rem), 14.5cqi);
    }
  }

  .hero__line {
    display: block;
  }

  .hero__desc {
    max-width: 36ch;
    margin-top: clamp(1.25rem, 3vh, 2rem);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .hero__cta {
    margin-top: var(--space-6);
  }

  .hero__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    padding-bottom: var(--space-5);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-min);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hero__scroll:hover {
    color: var(--color-text);
  }

  .hero__scroll-line {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: currentColor;
  }

  .hero__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2) var(--space-3);
    max-width: 100%;
    margin-left: auto;
  }

  .hero__sample {
    padding: 0.125rem var(--space-2);
    border: var(--border-width) dashed var(--color-border-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: var(--weight-ui);
    letter-spacing: 0.12em;
    overflow-wrap: anywhere;
  }

  .hero__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    padding: 0;
    border: var(--border-width) solid rgb(245 245 245 / 0.6);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: var(--color-text);
    cursor: pointer;
  }

  .hero__toggle:hover {
    border-color: var(--color-text);
    background: rgb(0 0 0 / 0.8);
  }

  .hero__toggle:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .hero__icon--pause,
  .hero[data-state='playing'] .hero__icon--play {
    display: none;
  }

  .hero[data-state='playing'] .hero__icon--pause {
    display: block;
  }

  /* 낮은 가로 화면: 여백을 줄이고 높이는 내용에 맞게 늘어난다 */
  @media (max-height: 30em) {
    /* 낮은 가로 화면에서는 화면 높이로도 제목 크기를 제한해 소개·버튼이 첫 화면에 보이게 한다 */
    .hero__title {
      font-size: min(clamp(2.5rem, 8.5vw, 10rem), 14.5cqi, 15svh);
    }

    .hero__content {
      padding-block: var(--space-5) var(--space-4);
    }

    .hero__desc {
      margin-top: var(--space-3);
    }

    .hero__cta {
      margin-top: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      transition: none;
    }
  }
</style>

<script>
  type Source = { url: string; type: string };

  const root = document.querySelector<HTMLElement>('[data-hero]');
  const video = root?.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  const status = root?.querySelector<HTMLElement>('[data-hero-status]');

  if (root && video && toggle) {
    const KEY = 'hero-video-paused';
    const store = {
      get: () => {
        try {
          return localStorage.getItem(KEY) === '1';
        } catch {
          return false;
        }
      },
      set: (paused: boolean) => {
        try {
          if (paused) localStorage.setItem(KEY, '1');
          else localStorage.removeItem(KEY);
        } catch {
          /* 저장소를 쓸 수 없는 환경 — 현재 페이지에서만 유지 */
        }
      },
    };
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    const isMobile = window.matchMedia('(max-width: 39.99em)').matches;

    let loaded = false;
    let failed = false;
    let wantPlaying = false; // 사용자가 멈추지 않았고 재생 중이어야 하는 상태
    let inView = true;

    const setState = (playing: boolean) => {
      root.dataset.state = playing ? 'playing' : 'paused';
      toggle.setAttribute('aria-label', playing ? '배경 영상 일시정지' : '배경 영상 재생');
    };

    const fail = () => {
      if (failed) return;
      failed = true;
      wantPlaying = false;
      root.classList.remove('is-video-visible');
      root.dataset.video = 'failed';
      setState(false);
      toggle.disabled = true;
      toggle.setAttribute('aria-label', '배경 영상을 불러올 수 없어 이미지로 표시 중');
      if (status) status.textContent = '배경 영상을 불러올 수 없어 이미지로 표시합니다.';
    };

    // 화면 크기에 맞는 파일 하나만 불러온다 (모바일·데스크톱 영상을 둘 다 받지 않음)
    const load = () => {
      if (loaded) return;
      loaded = true;
      let list: Source[] = [];
      try {
        list = JSON.parse((isMobile ? video.dataset.srcMobile : video.dataset.srcDesktop) ?? '[]');
      } catch {
        list = [];
      }
      if (!list.length) return fail();
      list.forEach((s, i) => {
        const el = document.createElement('source');
        el.src = s.url;
        el.type = s.type;
        if (i === list.length - 1) el.addEventListener('error', fail); // 마지막 후보까지 실패
        video.append(el);
      });
      video.load();
    };

    const play = async () => {
      if (failed) return;
      load();
      try {
        await video.play();
      } catch {
        // 자동 재생 차단·재생 불가: 포스터를 유지하고 사용자가 직접 재생할 수 있게 둔다
        if (!video.error) wantPlaying = false;
        setState(false);
      }
    };

    video.addEventListener('playing', () => {
      root.classList.add('is-video-visible');
      setState(true);
    });
    video.addEventListener('pause', () => setState(false));
    video.addEventListener('error', fail);

    toggle.addEventListener('click', () => {
      if (root.dataset.state === 'playing') {
        wantPlaying = false;
        store.set(true);
        video.pause();
      } else {
        wantPlaying = true;
        store.set(false);
        play();
      }
    });

    // 화면 밖·탭 숨김에서는 멈추고, 돌아오면 원래 재생 중이었던 경우에만 다시 재생
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (!inView) video.pause();
        else if (wantPlaying && !document.hidden) play();
      },
      { threshold: 0.05 },
    ).observe(root);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video.pause();
      else if (wantPlaying && inView) play();
    });

    // 재생 도중 모션 줄이기를 켜면 멈춘다
    reduceMotion.addEventListener('change', (e) => {
      if (e.matches) {
        wantPlaying = false;
        video.pause();
      }
    });

    setState(false);
    if (!store.get() && !reduceMotion.matches && !saveData) {
      wantPlaying = true;
      play();
    } else {
      root.dataset.video = store.get() ? 'user-paused' : 'reduced';
    }
  }
</script>
