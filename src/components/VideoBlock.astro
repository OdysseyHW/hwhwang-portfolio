---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase, responsive } from '../lib/url';

interface Props {
  src?: string | string[];
  youtubeId?: string;
  poster: ImageMetadata;
  posterAlt: string;
  title: string;
  caption?: string;
}

const { src, youtubeId, poster, posterAlt, title, caption } = Astro.props;
// 외부 URL이면 그대로, 아니면 public/ 기준 경로에 BASE_PATH 반영. 목록 순서대로 재생을 시도한다
const sources = (src ? (Array.isArray(src) ? src : [src]) : []).map((s) => {
  const url = /^https?:\/\//.test(s) ? s : withBase(s);
  return { url, type: url.endsWith('.webm') ? 'video/webm' : 'video/mp4' };
});
---

<figure class="video-block">
  {
    sources.length > 0 && (
      <video controls preload="none" playsinline poster={poster.src} width={poster.width} height={poster.height} aria-label={title}>
        {sources.map((s) => <source src={s.url} type={s.type} />)}
        <a href={sources[0].url}>영상 파일 열기</a>
      </video>
    )
  }
  {
    youtubeId && (
      <div class="video-block__facade" data-youtube={youtubeId} data-title={title}>
        <Image src={poster} alt={posterAlt} {...responsive(poster, [640, 1280, 1920], '(min-width: 80em) 1280px, 100vw')} loading="lazy" />
        <button type="button" class="video-block__play">
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M5 3.5v13l11-6.5-11-6.5Z" fill="currentColor" />
          </svg>
          <span>영상 재생: {title}</span>
        </button>
      </div>
    )
  }
  <figcaption>
    <strong>{title}</strong>
    {caption && <span class="muted">{caption}</span>}
  </figcaption>
</figure>

<style>
  .video-block {
    margin: 0;
  }

  video,
  .video-block__facade {
    width: 100%;
    height: auto;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }

  .video-block__facade {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .video-block__facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-block__facade :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-block__play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    max-width: calc(100% - 2rem);
    min-height: var(--tap-min);
    padding: var(--space-2) var(--space-5);
    border: 0;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-weight: 700;
    cursor: pointer;
  }

  figcaption {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow-wrap: anywhere;
    gap: var(--space-1);
    margin-top: var(--space-3);
    max-width: var(--reading-max);
    font-size: var(--text-sm);
  }
</style>

<script>
  // YouTube: 사용자가 재생 버튼을 누를 때만 플레이어를 불러온다
  document.querySelectorAll<HTMLElement>('[data-youtube]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(box.dataset.youtube ?? '')}?autoplay=1&rel=0`;
      iframe.title = box.dataset.title ?? 'YouTube 영상';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
